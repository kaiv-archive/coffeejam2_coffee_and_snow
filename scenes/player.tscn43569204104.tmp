resource_name = "rigid_player"
script/source = "extends RigidBody3D

@export var SPEED: float = 10.0
@export var LOSS_SPEED: float = 50.0
@export var GRAVITY_SCALE: float = 20.0
@export var MOUSE_SENSITIVITY: float = 0.002

@export var TILT_LOWER_LIMIT := deg_to_rad(-75.0)
@export var TILT_UPPER_LIMIT := deg_to_rad(80.0)

@export var CAMERA_CONTROLLER: Camera3D

@export var PICKUP_RAYCAST: RayCast3D

func get_ray_collider():
	return PICKUP_RAYCAST.get_collider()

func get_ray_point():
	return PICKUP_RAYCAST.get_collision_point()

func get_ray_normal():
	return PICKUP_RAYCAST.get_collision_normal()

func ray_global_position():
	return PICKUP_RAYCAST.global_position

func ray_global_transform():
	return PICKUP_RAYCAST.global_transform

func ray_global_basis():
	return PICKUP_RAYCAST.global_basis

@onready var spawnpoint = global_position

@export var PICKUP_SHAPECAST: ShapeCast3D


#func get_ray_collider():
	#return PICKUP_SHAPECAST.get_collider(0)
#
#func get_ray_point():
	#return PICKUP_SHAPECAST.get_collision_point(0)
#
#func get_ray_normal():
	#return PICKUP_SHAPECAST.get_collision_normal(0)
#
#func ray_global_position():
	#return PICKUP_SHAPECAST.global_position
#
#func ray_global_transform():
	#return PICKUP_SHAPECAST.global_transform
#
#func ray_global_basis():
	#return PICKUP_SHAPECAST.global_basis


@onready var HINTS = $\"../Hints\"

var PICKED_PIN : PinJoint3D
var PICKED_STATIC : StaticBody3D

var _mouse_input := false
var _rotation_input := 0.0
var _tilt_input := 0.0
var _mouse_rotation := Vector2.ZERO

var picked_item: RigidBody3D = null
var picked_joint: bool = false
var held_distance = 10.0
@export var dbg: Node3D
@export var ANIMATION: AnimationTree

var snowball = preload(\"res://scenes/snowball.tscn\").instantiate()

enum PLAYERSTATE {
	Controlled,
	CampFire,
	CoffeeMaker,
	Sitting
}

var current_state = PLAYERSTATE.Controlled

func on_home_exit():
	for fog in fogs:
		fog.hide()
	$Fog.show()
	var env = get_tree().get_nodes_in_group(\"environment\")[0].environment
	if !env.volumetric_fog_enabled:
		env.fog_enabled = true

func on_home_enter():
	for fog in fogs:
		fog.show()
	$Fog.hide()
	var env = get_tree().get_nodes_in_group(\"environment\")[0].environment
	if !env.volumetric_fog_enabled:
		env.fog_enabled = false


var fogs = []

func _ready() -> void:
	for fog in get_tree().get_nodes_in_group(\"outer_fog\"):
		fogs.push_back(fog)
	#Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	_mouse_input = false
	$stick_in.hide()
	GLOBAL.camera = $Camera
	GLOBAL.player = self
	GLOBAL.hints = HINTS

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"lmb\") and !_mouse_input:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	if event.is_action_pressed(\"ui_cancel\"):
		_mouse_input = !_mouse_input
		if _mouse_input:
			GLOBAL.settings.ease_show()
			Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		else:
			GLOBAL.settings.ease_hide()
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	
	if current_state == PLAYERSTATE.CampFire:
		stick_unhandled_input(event)

	if current_state not in [
		PLAYERSTATE.Controlled,
		PLAYERSTATE.Sitting
	]:
		return

	if event is InputEventMouseMotion \\
	and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		_rotation_input -= event.relative.x * MOUSE_SENSITIVITY
		_tilt_input -= event.relative.y * MOUSE_SENSITIVITY

func _process(_dt: float) -> void:
	if global_position.y < -100.0:
		HINTS.center_hint(\"back\", \"Q\", \"Вернуться\")
		if Input.is_action_just_pressed(\"back\"):
			global_position = spawnpoint
			linear_velocity = Vector3.ZERO
	else:
		HINTS.rm_hint(\"back\")
	
	tick_held(_dt)
	match current_state:
		PLAYERSTATE.Controlled:
			control_tick(_dt)
		PLAYERSTATE.Sitting:
			sit_tick(_dt)
		PLAYERSTATE.CampFire:
			campfire_tick(_dt)
			if Input.is_action_just_pressed(\"back\"):
				if !zefir_throwable():
					current_state = PLAYERSTATE.Controlled
					campfire_cleanup()
				else:
					zefir_on_stick = false
					#var z = zefirkla_shape.duplicate()
					#z.global_transform = zefirkla_shape.global_transform
					#var shape
					#var rb = RigidBody3D.new()
					#rb.add_child(shape)
					#get_tree().root.add_child(rb)
					#rb.global_transform = zefirkla_shape.global_transform
					$Sounds/Throw.play()
					zefirkla.hide()
		PLAYERSTATE.CoffeeMaker:
			coffeemaker_tick(_dt)

func _physics_process(delta: float) -> void:
	if current_state == PLAYERSTATE.CampFire: campfire_physics_tick(delta)

func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	integrate_control(state)




### ----- FREE -----

func integrate_control(state: PhysicsDirectBodyState3D):
	var norm: Vector3 = Vector3.ZERO
	if $ShapeCast3D.get_collision_count() != 0:
		norm = $ShapeCast3D.get_collision_normal(0)
	var max_slope_angle := deg_to_rad(50.0)
	var cos_max_slope := cos(max_slope_angle)
	
	var is_walkable := norm.dot(Vector3.UP) >= cos_max_slope
	
	_mouse_rotation.x = clamp(_mouse_rotation.x + _tilt_input, TILT_LOWER_LIMIT, TILT_UPPER_LIMIT)
	_mouse_rotation.y += _rotation_input
	rotation.y = _mouse_rotation.y
	CAMERA_CONTROLLER.rotation.x = _mouse_rotation.x
	CAMERA_CONTROLLER.rotation.z = 0.0
	_rotation_input = 0.0
	_tilt_input = 0.0
	var input_dir := Vector2.ZERO
	if current_state == PLAYERSTATE.Controlled:
		input_dir = Vector2(
			Input.get_axis(\"left\", \"right\"),
			Input.get_axis(\"forward\", \"backward\")
		)
	var direction := Vector3.ZERO
	if input_dir != Vector2.ZERO:
		direction = (global_transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
		ANIMATION.set(\"parameters/walk/blend_amount\", 1.0)
		ANIMATION.set(\"parameters/r_walk/blend_amount\", 1.0)
		ANIMATION.set(\"parameters/l_walk/blend_amount\", 1.0)
	else:
		ANIMATION.set(\"parameters/walk/blend_amount\", 0.0)
		ANIMATION.set(\"parameters/r_walk/blend_amount\", 0.0)
		ANIMATION.set(\"parameters/l_walk/blend_amount\", 0.0)
	var target_velocity := direction * SPEED
	var current_velocity := state.linear_velocity
	var new_velocity := current_velocity.move_toward(
		Vector3(target_velocity.x, current_velocity.y, target_velocity.z),
		LOSS_SPEED * state.step
	)
	state.linear_velocity = new_velocity

	var gravity := Vector3.DOWN * GRAVITY_SCALE * mass * state.step
	if is_walkable:
		gravity = gravity.slide(norm)
	
	
	if current_state != PLAYERSTATE.CampFire:
		apply_central_impulse(gravity)

	
	if picked_item:
		if picked_joint:
			var target_pos = ray_global_position() - ray_global_transform().basis.z * held_distance
			var dir = target_pos - picked_item.global_position
			picked_item.linear_velocity = linear_velocity + dir * 10.0
		else:
			PICKED_STATIC.global_position = ray_global_position() - ray_global_transform().basis.z * held_distance
	$Camera/CanvasLayer/AspectRatioContainer/SubViewportContainer/SubViewport/Camera.global_transform = $Camera.global_transform
	$Camera/CanvasLayer/AspectRatioContainer/SubViewportContainer/SubViewport.size = get_window().size


func control_tick(_dt: float):
	var on_ground = $ShapeCast3D.get_collision_count() != 0 and $ShapeCast3D.get_collider(0) != null
	if Input.is_action_pressed(\"space\") && on_ground:
		$Cat_Winter.position.y = lerpf($Cat_Winter.position.y, 0.0, _dt * 10.0)
		$Camera.position.y = lerpf($Camera.position.y , 0.425, _dt * 10.0)
		#$Held.position.y = lerpf($Held.position.y, -0.55, _dt * 10.0);
		$Held.position.y = lerpf($Held.position.y, -0.55, _dt * 10.0);
		ANIMATION.set(\"parameters/body_crawl/blend_amount\", 1.0)
	else:
		$Cat_Winter.position.y = lerpf($Cat_Winter.position.y, 0.545, _dt * 10.0)
		$Camera.position.y = lerpf($Camera.position.y, 0.925, _dt * 10.0)
		#$Held.position.y = lerpf($Held.position.y, 0.0, _dt * 10.0);
		$Held.position.y = lerpf($Held.position.y, 0.0, _dt * 10.0);
		ANIMATION.set(\"parameters/body_crawl/blend_amount\", 0.0)
	if Input.is_action_just_released(\"space\") && on_ground:
		apply_central_impulse(Vector3.UP * 8.0)
	
	if Input.is_action_just_released(\"lmb\") and picked_item:
		picked_item.sleeping = false
		if !picked_joint:
			picked_item.center_of_mass_mode = RigidBody3D.CENTER_OF_MASS_MODE_AUTO
			PICKED_PIN.queue_free()
			PICKED_PIN = null
			PICKED_STATIC.queue_free()
			PICKED_STATIC = null
		picked_item = null
	var body = get_ray_collider()
	if Input.is_action_just_pressed(\"lmb\"):
		if body and body is RigidBody3D and picked_item == null and body.is_in_group(\"pickable\"):
			picked_item = body
			var d = get_ray_point()
			held_distance = (d - ray_global_position()).length()
			if picked_item.is_in_group(\"pickable_joint\"):
				picked_joint = true
			else:
				var p := PinJoint3D.new()
				var s := StaticBody3D.new()
				get_tree().root.add_child(s)
				get_tree().root.add_child(p)
				p.set(\"params/bias\", 0.1)
				p.global_position = d
				s.global_position = d
				p.node_b = s.get_path()
				p.node_a = body.get_path()
				p.solver_priority = 2
				PICKED_PIN = p
				PICKED_STATIC = s
				picked_joint = false
	if body and body.is_in_group(\"pickable\") and !picked_item:
		HINTS.center_hint(\"pick\", \"ЛКМ\", \"Тянуть\")
	else:
		HINTS.rm_hint(\"pick\")
	if body and body.is_in_group(\"make_snowballs\") and !picked_item and !held_item:
		HINTS.hint(\"make_snowball\", \"F\", \"Слепить снежок\")
		if Input.is_action_just_pressed(\"use_held\"):
			var b = snowball.duplicate()
			get_tree().root.add_child(b)
			pick_item(b)
	else:
		HINTS.rm_hint(\"make_snowball\")
	if body and body.is_in_group(\"heldable\") and !held_item and !picked_item:
		HINTS.center_hint(\"take\", \"E\", \"Взять\")
		if Input.is_action_just_pressed(\"interact\"):
			pick_item(body)
	else:
		HINTS.rm_hint(\"take\")
	
	if held_item:
		HINTS.hint(\"throw\", \"Q\", \"Выбросить\")
		ANIMATION.set(\"parameters/l_pick/blend_amount\", 1.0)
		if Input.is_action_just_pressed(\"back\"):
			throw_item()
	else:
		ANIMATION.set(\"parameters/l_pick/blend_amount\", 0.0)
		HINTS.rm_hint(\"throw\")
	
	if body and body.is_in_group(\"hint\"):
		HINTS.center_hint_raw(body.hint())
	else:
		HINTS.rm_hint(\"label_hint\")
	
	if body and body.is_in_group(\"interactable\") and !picked_item:
		if body.is_in_group(\"campfire\"):
			HINTS.center_hint(\"ecook\", \"E\", \"Жарить маршмелов\")
			if Input.is_action_just_pressed(\"interact\"):
				current_state = PLAYERSTATE.CampFire
				campfire_setup(body.global_position)
		else:
			HINTS.rm_hint(\"ecook\")
		
		if body.is_in_group(\"image\"):
			HINTS.center_hint(\"eimage\", \"E\", \"Повесить картину\")
			if Input.is_action_just_pressed(\"interact\"):
				image_setup(body)
		else:
			HINTS.rm_hint(\"eimage\")
		
		if body.is_in_group(\"coffeemaker\"):
			HINTS.center_hint(\"ecoffee\", \"E\", \"Готовить кофе\")
			if Input.is_action_just_pressed(\"interact\"):
				coffeemaker_setup(body)
		else:
			HINTS.rm_hint(\"ecoffee\")
		if body.is_in_group(\"log\"):
			HINTS.center_hint(\"esit\", \"E\", \"Сесть\")
			if Input.is_action_just_pressed(\"interact\"):
				current_state = PLAYERSTATE.Sitting
				sit_setup(body)
		else:
			HINTS.rm_hint(\"esit\")
	else:
		HINTS.rm_hint(\"esit\")
		HINTS.rm_hint(\"ecoffee\")
		HINTS.rm_hint(\"ecook\")
	

var temp_body
func image_setup(body):
	var picker = $\"../FileDialog\"
	temp_body = body
	
	



func _on_file_dialog_file_selected(path: String) -> void:
	var img_mesh: MeshInstance3D = temp_body.img
	var image := Image.new()
	var texture := ImageTexture.create_from_image(image)
	var err = image.load(path)
	if err != OK:
		return
	var mat := img_mesh.get_active_material(0)
	if mat == null:
		mat = StandardMaterial3D.new()
		img_mesh.set_surface_override_material(0, mat)
	mat.albedo_texture = texture


### ----- SITTING -----

var sit_target_pos: Vector3
var sit_target_yaw: float
var sit_speed := 5.0
var sit_rot_speed := 6.0

var sit_log_basis: Basis
var sit_local_yaw := 0.0

const SIT_YAW_LIMIT := deg_to_rad(60.0)
const SIT_SOFTNESS := 8.0 # скорость возврата
var sit_base_yaw := 0.0


@onready var default_collision_mask = collision_mask

func sit_setup(sitable: Node3D):
	$Sounds/Sit.play()
	freeze = true
	collision_mask = 0
	current_state = PLAYERSTATE.Sitting
	HINTS.rm_hint(\"esit\")
	HINTS.hint(\"q\", \"Q\", \"Встать\")
	ANIMATION.set(\"parameters/sit/blend_amount\", 1.0)

	sit_target_pos = sitable.global_position + -sitable.transform.basis.z * Vector3(1.0, 1.0, 1.0)
	

	sit_log_basis = sitable.global_transform.basis

	var player_forward := -global_transform.basis.z
	player_forward.y = 0.0
	player_forward = player_forward.normalized()

	var local_forward := sit_log_basis.inverse() * player_forward

	sit_local_yaw = atan2(local_forward.x, local_forward.z)

	_rotation_input = 0.0
	_tilt_input = 0.0
	if held_item: held_item.on_state_enter(PLAYERSTATE.Sitting)

func sit_tick(dt: float):
	# посадка
	global_position = global_position.lerp(
		sit_target_pos,
		dt * sit_speed
	)

	# свободное вращение
	_mouse_rotation.y += _rotation_input
	_mouse_rotation.x = clamp(
		_mouse_rotation.x + _tilt_input,
		TILT_LOWER_LIMIT,
		TILT_UPPER_LIMIT
	)

	# считаем текущий forward
	var forward := -Basis(Vector3.UP, _mouse_rotation.y).z
	forward.y = 0.0
	forward = forward.normalized()

	# в локальное пространство бревна
	var local_forward := sit_log_basis.inverse() * forward
	var _local_yaw := atan2(local_forward.x, local_forward.z)
	
	#var err = local_yaw - sit_local_yaw
	#print(local_yaw)
#
	## мягкое ограничение
	#var delta := wrapf(local_yaw - sit_local_yaw, -PI, PI)
#
	#if abs(delta) > SIT_YAW_LIMIT:
		#var excess = delta - sign(delta) * SIT_YAW_LIMIT
		## excess — насколько мы ВЫШЛИ за окно
#
		## перевод excess из локального пространства бревна в мировой yaw
		#var correction_strength := dt * SIT_SOFTNESS
		#_mouse_rotation.y -= excess * correction_strength
#
	rotation.y = _mouse_rotation.y
	CAMERA_CONTROLLER.rotation.x = _mouse_rotation.x
#
	_rotation_input = 0.0
	_tilt_input = 0.0

	if Input.is_action_just_pressed(\"back\"):
		sit_cleanup()

func sit_cleanup():
	HINTS.rm_hint(\"q\")
	current_state = PLAYERSTATE.Controlled
	freeze = false
	collision_mask = default_collision_mask
	ANIMATION.set(\"parameters/sit/blend_amount\", 0.0)
	if held_item: held_item.on_state_exit(PLAYERSTATE.Sitting)


### ----- ITEM -----

var held_item : RigidBody3D = null
func pick_item(body: RigidBody3D):
	body.freeze = true
	var s = body.get_node(\"CollisionShape3D\")
	if s:
		s.disabled = true
	for hint in body.hints():
		HINTS.hint_raw(hint)
	body.reparent($Held/Held2, false)
	body.transform = Transform3D.IDENTITY
	body.on_pickup()
	held_item = body

func throw_item():
	held_item.freeze = false
	var s = held_item.get_node(\"CollisionShape3D\")
	if s:
		s.disabled = false
	for hint in held_item.hints():
		var key = hint[0]
		HINTS.rm_hint(key)
	held_item.reparent(get_tree().root, true)
	$Sounds/Throw.play()
	for hint in held_item.ray_hints(get_ray_collider()):
		HINTS.rm_hint(hint[0])
	held_item.cleanup()
	if held_item is RigidBody3D:
		held_item.linear_velocity = -ray_global_basis().z * 5.0
		held_item.angular_velocity = Vector3(
			randf_range(-0.5, 0.5) * 5.0,
			randf_range(-0.5, 0.5) * 5.0,
			randf_range(-0.5, 0.5) * 5.0
		)
	held_item = null


func use_item():
	held_item.use(get_ray_point(), ray_global_basis().z, get_ray_collider(), get_ray_normal())

func tick_held(_dt):
	if !held_item: return
	held_item.tick_ray(get_ray_point(), ray_global_basis().z, get_ray_collider(), get_ray_normal())
	if get_ray_collider():
		for hint in held_item.ray_hints(get_ray_collider()):
			HINTS.center_hint_raw(hint)
	else:
		for hint in held_item.ray_hints(get_ray_collider()):
			HINTS.rm_hint(hint[0])
	if Input.is_action_just_pressed(\"use_held\"):
		use_item()



### ----- COFFEE -----

var strelka_max = 21
var zone_max = 16
var zone_size = 5.3
var strelka_dir = 1
var strelka_speed = 0.4
var zone_pos 
var coffeemaker

func coffeemaker_setup(_body: Node3D):
	$\"../CoffeeMinigame/Control\".show()
	current_state = PLAYERSTATE.CoffeeMaker
	HINTS.hint(\"q\", \"Q\", \"Уйти\")
	HINTS.rm_hint(\"ecoffee\")
	HINTS.center_top_hint(\"e\", \"E\", \"Завершить\")
	$\"../CoffeeMinigame/Control/Strelka\".rotation = -strelka_max * 2.0 * PI / 360
	zone_pos =  randf_range(-zone_max, zone_max)
	$\"../CoffeeMinigame/Control/Zone\".rotation = zone_pos * 2.0 * PI / 360
	coffeemaker = _body
	if held_item: held_item.on_state_enter(PLAYERSTATE.CoffeeMaker)

func coffeemaker_tick(_dt):
	$\"../CoffeeMinigame/Control/Strelka\".rotation += _dt * strelka_speed * strelka_dir
	var strelka_pos = $\"../CoffeeMinigame/Control/Strelka\".rotation / 2.0 / PI * 360
	if Input.is_action_just_pressed(\"interact\"):
		if strelka_pos > zone_pos - zone_size and strelka_pos < zone_pos + zone_size:
			# todo: spawn
			$Sounds/Coffeemachine.play()
			coffeemaker.spawn()
			coffeemaker_cleanup()
			return
		else:
			# todo: broke
			coffeemaker_cleanup()
			return
	if $\"../CoffeeMinigame/Control/Strelka\".rotation > strelka_max * 2.0 * PI / 360:
		strelka_dir = -1
	if $\"../CoffeeMinigame/Control/Strelka\".rotation < -strelka_max * 2.0 * PI / 360:
		strelka_dir = 1
	if Input.is_action_just_pressed(\"back\"):
		coffeemaker_cleanup()

func coffeemaker_cleanup():
	$\"../CoffeeMinigame/Control\".hide()
	current_state = PLAYERSTATE.Controlled
	HINTS.rm_hint(\"q\")
	HINTS.rm_hint(\"e\")
	if held_item: held_item.on_state_exit(PLAYERSTATE.CoffeeMaker)




### ----- CAMPFIRE -----

var campfire_speed = 4.5
var campfire_rot_speed = 4.5
var campfire_target = Vector3.ZERO
var campfire_rot_target = Vector3.ZERO

func campfire_setup(target):
	zefir_progress = 1.0
	HINTS.hint(\"q\", \"Q\", \"Уйти\")
	HINTS.hint(\"shift\", \"Shift\", \"Вытянуть\")
	HINTS.rm_hint(\"ecook\")
	campfire_target = target + ((global_position - target) * Vector3(1.0, 0.0, 1.0)).normalized() * 3.0
	campfire_rot_target = target
	$stick_initial.play(\"in\")
	$zefirka.play(\"RESET\")
	$stick.play(\"pull\")
	zefir_on_stick = true
	freeze = true
	if held_item: held_item.on_state_enter(PLAYERSTATE.CampFire)

var zefir_progress = 1.0
var zefir_on_stick = true
var zefir_speed = 0.12

var stick_rot := Vector2.ZERO
@export var STICK_SENS := 0.003
@export var STICK_PITCH_LIMIT := Vector2(deg_to_rad(-30), deg_to_rad(30))
@export var STICK_YAW_LIMIT   := Vector2(deg_to_rad(-60), deg_to_rad(60))
var stick_push := false
@onready var STICK = $stick_in/zefirka_root/stick
@export var STICK_RETURN_SPEED := 6.0
@onready var zefirkla = $stick_in/zefirka_root/stick/stick/zefirka
func stick_unhandled_input(event):
	if event is InputEventMouseMotion \\
	and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED \\
	and current_state == PLAYERSTATE.CampFire \\
	and stick_push \\
	:
		stick_rot.y -= event.relative.x * STICK_SENS
		stick_rot.x -= event.relative.y * STICK_SENS
		stick_rot.x = clamp(
			stick_rot.x,
			STICK_PITCH_LIMIT.x,
			STICK_PITCH_LIMIT.y
		)
		stick_rot.y = clamp(
			stick_rot.y,
			STICK_YAW_LIMIT.x,
			STICK_YAW_LIMIT.y
		)

func zefir_throwable():
	return zefir_progress < 0.2 and !stick_push and zefir_on_stick

func campfire_tick(dt: float):
	if !zefir_on_stick:
		HINTS.center_hint(\"swap\", \"E\", \"Заменить\")
		if Input.is_action_just_pressed(\"interact\"):
			zefir_on_stick = true
			zefir_progress = 1.0
			$zefirka.play(\"swap\")
	else:
		HINTS.rm_hint(\"swap\")
	if !stick_push:
		if zefir_throwable():
			HINTS.center_hint(\"eat\", \"E\", \"Скушать\")
			HINTS.center_hint(\"throw\", \"Q\", \"Выкинуть\")
			if Input.is_action_just_pressed(\"interact\"):
				zefir_on_stick = false
				zefirkla.hide()
				$Sounds/CookieOvercooked.play()
		elif zefir_progress < 0.5 and zefir_on_stick:
			HINTS.center_hint(\"eat\", \"E\", \"Скушать\")
			if Input.is_action_just_pressed(\"interact\"):
				$Sounds/CookieYummy.play()
				zefir_on_stick = false
				zefirkla.hide()
		else:
			HINTS.rm_hint(\"eat\")
			HINTS.rm_hint(\"throw\")
	else:
		HINTS.rm_hint(\"throw\")
		HINTS.rm_hint(\"eat\")
		
	global_position = global_position.lerp(
		campfire_target,
		dt * campfire_speed
	)
	var dir = (global_position - campfire_rot_target).normalized()
	var target_yaw = atan2(dir.x, dir.z)
	_mouse_rotation.y = lerp_angle(_mouse_rotation.y, target_yaw, dt * campfire_rot_speed)
	rotation.y = _mouse_rotation.y
	var target_pitch = asin(dir.y)
	_mouse_rotation.x = lerp(
		_mouse_rotation.x,
		clamp(target_pitch, TILT_LOWER_LIMIT, TILT_UPPER_LIMIT),
		dt * campfire_rot_speed
	)
	CAMERA_CONTROLLER.rotation.x = _mouse_rotation.x
	var areas = $stick_in/zefirka_root/stick/stick/zefirka/Area3D.get_overlapping_areas()
	for area in areas:
		if area.is_in_group(\"zefir_burn\"):
			zefir_progress = -1.0
		if area.is_in_group(\"zefir_cook\"):
			if zefir_progress > 0.0:
				zefir_progress -= zefir_speed * dt
	
	if zefir_progress < 0.0:
		zefirkla.material_override.albedo_color = Color.BLACK
	else:
		var v = zefir_progress
		var c = v * Color.from_rgba8(255, 255, 255, 255) + (1 - v) * Color.from_rgba8(74, 43, 0, 255)
		c.a = 1
		zefirkla.material_override.albedo_color = c
	
	if Input.is_action_just_pressed(\"shift\"):
		stick_push = true
		$stick.play(\"push\")
	
	if Input.is_action_just_released(\"shift\"):
		stick_push = false
		$stick.play(\"pull\")
	
	if stick_push:
		STICK.rotation.z = lerp(
			STICK.rotation.z,
			-stick_rot.y,
			dt * 10.0
		)
		STICK.rotation.y = lerp(
			STICK.rotation.y,
			-stick_rot.x,
			dt * 10.0
		)
	else:
		STICK.rotation.z = lerp(
			STICK.rotation.z,
			0.0,
			dt * STICK_RETURN_SPEED
		)
		STICK.rotation.y = lerp(
			STICK.rotation.y,
			0.0,
			dt * STICK_RETURN_SPEED
		)
		stick_rot = stick_rot.lerp(Vector2.ZERO, dt * STICK_RETURN_SPEED)

func campfire_physics_tick(_dt):
	pass

func campfire_cleanup():
	freeze = false
	linear_velocity = Vector3.ZERO
	HINTS.rm_hint(\"q\")
	HINTS.rm_hint(\"shift\")
	$stick_initial.play(\"out\")
	HINTS.rm_hint(\"swap\")
	HINTS.rm_hint(\"throw\")
	HINTS.rm_hint(\"eat\")
	if held_item: held_item.on_state_exit(PLAYERSTATE.CampFire)
"

