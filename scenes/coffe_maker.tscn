[sub_resource type="GDScript" id="GDScript_a8y0u"]
resource_name = "coffeemaker"
script/source = "extends StaticBody3D

var coffee = preload(\"res://scenes/coffee_jam_2_cup.tscn\")

func spawn():
	var c = coffee.instantiate()
	get_tree().root.add_child(c)
	c.global_position = $Spawnpoint.global_position
"

