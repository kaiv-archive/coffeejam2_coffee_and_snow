[gd_scene format=4 uid="uid://f0iy44441tlm"]

[sub_resource type="GDScript" id="GDScript_bfm7l"]
script/source = "extends Heldable

func cleanup():
	GLOBAL.hints.rm_hint(\"rm_snowball\")

func ray_hints(_body):
	if !can_use(_body):
		GLOBAL.hints.rm_hint(\"rm_snowball\")
		return []
	return [
		[\"rm_snowball\", \"F\", \"Убрать\"],
	]

func hint():
	return [
		\"label_hint\", \"F\", \"Убрать\"
	]
	


func use(_point: Vector3, _dir, _body, _normal):
	if !can_use(_body): return
	GLOBAL.player.get_node(\"Sounds/SnowballPaste\").play()
	_body.queue_free()
	#var body = StaticBody3D.new()
	#get_tree().root.add_child(body)
	#var c = $CollisionShape3D.duplicate()
	#c.disabled = false
	#body.add_child(c)
	#body.add_child($MeshInstance3D.duplicate())
	#cleanup()
	#self.queue_free()
	#get_tree().create_timer(0.001).timeout.connect(func (): GLOBAL.hints.rm_hint(\"rm_snowball\"))

func on_state_enter(_state):
	self.disabled = true
	cleanup()

func on_state_exit(_state):
	self.disabled = false

func can_use(_body):
	if self.disabled: return false
	if !_body: return false
	if !_body.is_in_group(\"snowball\") && !_body.is_in_group(\"pasted\"): return false
	return true

func on_pickup():
	GLOBAL.player.get_node(\"Sounds/Snowball\").play()
"

