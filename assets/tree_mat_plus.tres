[sub_resource type="Shader" id="Shader_hetp2"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.6.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx, alpha_to_coverage, vertex_lighting;


uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform float alpha_scissor_threshold : hint_range(0.0, 1.0, 0.001);
uniform float alpha_antialiasing_edge : hint_range(0.0, 1.0, 0.01);
uniform ivec2 albedo_texture_size;
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

uniform sampler2D tex;
uniform sampler2D wind_noise; // текстура шума (tileable)

uniform float wind_strength = 0.2;
uniform float wind_speed = 1.5;
uniform vec2 wind_dir = vec2(1.0, 0.3);

uniform float noise_scale = 0.1;   // масштаб шума в мире
uniform float noise_strength = 1.0;
uniform float y_sway = 0.5;        // вклад покачивания по Y
void vertex() {
    // мировая позиция
    vec3 world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;

    // нормализованное направление ветра
    vec2 wind_dir_ws = normalize(wind_dir);

    // фаза ветра в мировой плоскости
    float wind_phase =
        dot(world_pos.xz, wind_dir_ws) +
        TIME * wind_speed;

    // координаты шума
    vec2 noise_uv = world_pos.xz * noise_scale +
                    wind_dir_ws * TIME * wind_speed;
    float noise = texture(wind_noise, noise_uv).r * 2.0 - 1.0;

    // сила ветра (одинаково для всех)
    float wind_offset = sin(wind_phase + noise * noise_strength) *
                        wind_strength;

    // боковое раскачивание
    VERTEX.x += wind_dir_ws.x * wind_offset;
    VERTEX.z += wind_dir_ws.y * wind_offset;

    // вертикальное мягкое раскачивание
    VERTEX.y += cos(wind_phase * 0.7 + noise) *
                wind_offset * y_sway;
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	float metallic_tex = dot(texture(texture_metallic, base_uv), metallic_texture_channel);
	METALLIC = metallic_tex * metallic;
	SPECULAR = specular;

	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	float roughness_tex = dot(texture(texture_roughness, base_uv), roughness_texture_channel);
	ROUGHNESS = roughness_tex * roughness;
	ALPHA *= albedo.a * albedo_tex.a;
	ALPHA_SCISSOR_THRESHOLD = alpha_scissor_threshold;
	ALPHA_ANTIALIASING_EDGE = alpha_antialiasing_edge;
	ALPHA_TEXTURE_COORDINATE = UV * vec2(albedo_texture_size);
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_hetp2")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/texture_albedo = ExtResource("1_x51t8")
shader_parameter/alpha_scissor_threshold = 0.5
shader_parameter/alpha_antialiasing_edge = 0.3
shader_parameter/albedo_texture_size = Vector2i(1200, 1800)
shader_parameter/point_size = 1.0
shader_parameter/roughness = 1.0
shader_parameter/metallic_texture_channel = Vector4(1, 0, 0, 0)
shader_parameter/specular = 0.5
shader_parameter/metallic = 0.0
shader_parameter/uv1_scale = Vector3(1, 1, 1)
shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/uv2_scale = Vector3(1, 1, 1)
shader_parameter/uv2_offset = Vector3(0, 0, 0)
shader_parameter/wind_noise = ExtResource("2_x51t8")
shader_parameter/wind_strength = 0.4
shader_parameter/wind_speed = 0.2
shader_parameter/wind_dir = Vector2(1, 0.3)
shader_parameter/noise_scale = 0.1
shader_parameter/noise_strength = 1.0
shader_parameter/y_sway = 0.5
